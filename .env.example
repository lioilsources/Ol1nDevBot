# --- Discord (required) ---
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- Deploy hook: POST https://hooks.ol1n.com/discordbot/deploy, header X-Signature: sha256=<hmac hex> ---
DEPLOY_HOOK_SECRET=
HTTP_ADDR=:8080

# --- App Store Connect API (role Sales and Reports); leave empty to disable ---
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=/secrets/AuthKey.p8
ASC_VENDOR_NUMBER=

# --- Google Play service account; leave empty to disable ---
GPLAY_SA_JSON_PATH=/secrets/gplay-sa.json
GPLAY_REPORTS_BUCKET=pubsite_prod_rev_XXXXXXXX

# --- GitHub fine-grained PAT (read-only Contents, Metadata, Pull requests) ---
GITHUB_TOKEN=

# --- LiteLLM on Spark (OpenAI compatible); without LLM_MODEL the changelog is a raw list ---
LLM_BASE_URL=http://spark:4000/v1
LLM_API_KEY=
LLM_MODEL=

DB_PATH=/data/ol1nbot.db
APPS_YAML=/config/apps.yaml
TZ=Europe/Prague
LOG_LEVEL=info
